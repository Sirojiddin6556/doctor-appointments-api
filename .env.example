# Copy this file to .env and adjust values if you want to override the
# development defaults baked into docker-compose.yml. This is optional --
# `docker compose up` works without a .env file at all.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-in-real-deployments
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (used by both the db and api services)
POSTGRES_DB=clinic_db
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=clinic_dev_pass
# POSTGRES_HOST / POSTGRES_PORT are set by docker-compose.yml itself when
# running via Docker (POSTGRES_HOST=db). Only relevant when running the app
# directly on your machine against a local Postgres -- see README.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

# Bonus: rate limiting on POST /api/auth/login/
LOGIN_THROTTLE_RATE=5/min

# Pagination page size for list endpoints
DRF_PAGE_SIZE=20
