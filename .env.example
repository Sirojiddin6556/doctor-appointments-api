# Скопируйте файл в .env и подставьте свои значения.
# Для локального `docker compose up` .env НЕ обязателен — рабочие значения
# уже заданы в docker-compose.yml. Значения ниже — ориентир для боевого стенда.

# Django
# Сгенерируйте длинный случайный ключ, напр.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-64-char-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# Прод по HTTPS: редирект и HSTS включены (при DEBUG=False это значения
# по умолчанию, здесь показаны явно). Для локального HTTP-стенда ставьте False/0.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000

# PostgreSQL (используется сервисами db и api)
POSTGRES_DB=clinic_db
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=replace-with-a-strong-db-password
# При запуске в Docker POSTGRES_HOST и POSTGRES_PORT задаются Compose.
# Эти значения нужны только для локального запуска против PostgreSQL на хосте.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

# Ограничение частоты запросов к POST /api/auth/login/
LOGIN_THROTTLE_RATE=5/min

# Размер страницы для списков API (клиент может переопределить ?page_size=).
DRF_PAGE_SIZE=20

# Уровень логирования приложения: DEBUG, INFO, WARNING или ERROR.
LOG_LEVEL=INFO

# Наполнять пустую базу демо-данными при старте контейнера.
SEED_DEMO_DATA=false
